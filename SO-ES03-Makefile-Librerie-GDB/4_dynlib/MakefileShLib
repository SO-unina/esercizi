CURR = $(PWD)

.PHONY: all clean

all: calc

calc: libmat.so main.o
	gcc -o calc main.o -L$(CURR)/ -lmat

main.o: main.c mat.h
	gcc -c main.c

libmat.so: mat.o
	gcc -shared -Wl,-soname,libmat.so -o libmat.so mat.o

mat.o: mat.c mat.h
	gcc -c -fpic mat.c

clean:
	rm -f *.o
	rm -f ./calc
	rm -f libmat.so
